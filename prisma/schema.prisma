generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  ADMIN
  USER
  OBSERVER
}
enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(USER)
  status AccountStatus @default(PENDING)
  createdAt DateTime @default(now())
  sessions Session[]
  projects Project[]
  memberships ProjectMember[]
  categoryMemberships CategoryMember[]
  subproductMemberships SubproductMember[]
  passwordResets PasswordReset[]
  ownerRecovery OwnerRecovery?
}
model PasswordReset {
  tokenHash String @id
  userId String
  user User @relation(fields:[userId],references:[id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id])
  expiresAt DateTime
  @@index([expiresAt])
}
model Project {
  id String @id @default(cuid())
  seedKey String? @unique
  name String
  description String @default("")
  prompt String @default("")
  ownerId String
  owner User @relation(fields:[ownerId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  categories Category[]
  members ProjectMember[]
  brandKit BrandKit?
  allAdministrators Boolean @default(false)
}
model ProjectMember {
  projectId String
  userId String
  permission String @default("VIEW")
  project Project @relation(fields:[projectId],references:[id])
  user User @relation(fields:[userId],references:[id])
  @@id([projectId,userId])
}
model Category {
  id String @id @default(cuid())
  name String
  prompt String @default("")
  projectId String
  project Project @relation(fields:[projectId],references:[id])
  settings Json @default("{}")
  applyPromptToAll Boolean @default(true)
  applySettingsToAll Boolean @default(true)
  subproducts Subproduct[]
  members CategoryMember[]
  @@index([projectId])
}
model Subproduct {
  id String @id @default(cuid())
  name String
  prompt String @default("")
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  settings Json @default("{}")
  deletedAt DateTime?
  members SubproductMember[]
  variations Variation[]
  @@index([categoryId])
  @@index([categoryId,deletedAt])
}
model PromptVersion {
  id String @id @default(cuid())
  scope String
  resourceId String
  prompt String
  actorId String
  createdAt DateTime @default(now())
  @@index([resourceId,createdAt])
}
model Attachment {
  id String @id @default(cuid())
  scope String
  resourceId String
  name String
  mime String
  purpose String
  path String
  text String @default("")
  size Int
  createdAt DateTime @default(now())
  archivedAt DateTime?
  replacesId String?
  brandLogos BrandLogo[]
  @@index([scope,resourceId])
}

model BrandKit {
  projectId String @id
  project Project @relation(fields:[projectId],references:[id])
  name String @default("")
  prompt String @default("")
  colors Json @default("[]")
  font String?
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  logos BrandLogo[]
}
model BrandLogo {
  projectId String
  brand BrandKit @relation(fields:[projectId],references:[projectId],onDelete:Cascade)
  attachmentId String
  attachment Attachment @relation(fields:[attachmentId],references:[id],onDelete:Restrict)
  @@id([projectId,attachmentId])
}
model ProviderConfiguration {
  id String @id @default("global")
  provider String @default("openai")
  encryptedKey String?
  maskedKey String?
  revision Int @default(1)
  verifiedRevision Int?
  verifiedAt DateTime?
  status String @default("NOT_CONFIGURED")
  error String?
  models Json @default("[]")
  imageModel String?
  creativeModel String?
  creativeProvider String?
  alternatives Json @default("[]")
  quality String @default("low")
  resolution String @default("1024x1024")
  monthlyLimitMicros BigInt @default(0)
  dailyLimitMicros BigInt @default(0)
  operationLimitMicros BigInt @default(0)
  imageReserveMicros BigInt @default(0)
  maxGenerations Int @default(100)
  updatedAt DateTime @updatedAt
}
model GenerationJob {
  id String @id @default(cuid())
  actorId String
  projectId String
  subproductId String?
  idempotencyKey String @unique
  status String @default("PENDING")
  snapshot Json
  reservedMicros BigInt
  archivedAt DateTime?
  error String?
  startedAt DateTime?
  leaseToken String?
  heartbeatAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  variation Variation?
  @@index([status,createdAt])
  @@index([status,heartbeatAt], map: "GenerationJob_heartbeat_idx")
  @@index([archivedAt,createdAt], map: "GenerationJob_archive_idx")
}
model BackgroundBatch {
  id String @id @default(cuid())
  actorId String
  requestKey String @unique
  jobIds Json
  status String @default("STARTING")
  runId String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([actorId,createdAt])
}
model Variation {
  id String @id @default(cuid())
  subproductId String?
  subproduct Subproduct? @relation(fields:[subproductId],references:[id])
  jobId String @unique
  job GenerationJob @relation(fields:[jobId],references:[id])
  path String
  model String
  permanent Boolean @default(false)
  favorite Boolean @default(false)
  reviewStatus String @default("PENDING")
  revision Int @default(1)
  deletedAt DateTime?
  versions ImageVersion[]
  libraryItems LibraryItem[]
  expiresAt DateTime
  expired Boolean @default(false)
  filesQueuedAt DateTime?
  createdAt DateTime @default(now())
  @@index([permanent,filesQueuedAt,expiresAt], map: "Variation_expiry_cleanup_idx")
}
model UsageLedger {
  id String @id @default(cuid())
  jobId String @unique
  actorId String
  projectId String
  model String
  reservedMicros BigInt
  actualMicros BigInt?
  usage Json?
  status String @default("RESERVED")
  createdAt DateTime @default(now())
  @@index([createdAt,status])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String
  action String
  resourceId String?
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
}
model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
}

model ImageVersion {
  id String @id @default(cuid())
  variationId String
  variation Variation @relation(fields:[variationId],references:[id])
  number Int
  path String
  backgroundPath String?
  document Json?
  actorId String
  sourceJobId String? @unique
  createdAt DateTime @default(now())
  @@unique([variationId,number])
}

model LibraryFolder {
  id String @id @default(cuid())
  userId String
  name String
  parentId String?
  parent LibraryFolder? @relation("FolderTree",fields:[parentId],references:[id])
  children LibraryFolder[] @relation("FolderTree")
  items LibraryItem[]
  createdAt DateTime @default(now())
  @@index([userId,parentId])
}
model LibraryItem {
  id String @id @default(cuid())
  userId String
  variationId String
  variation Variation @relation(fields:[variationId],references:[id])
  folderId String?
  folder LibraryFolder? @relation(fields:[folderId],references:[id])
  createdAt DateTime @default(now())
  @@unique([userId,variationId])
}
model SavedPreset {
  id String @id @default(cuid())
  userId String
  name String
  prompt String
  settings Json
  visibility String @default("PERSONAL")
  applyPromptToAll Boolean @default(true)
  applySettingsToAll Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PresetShare {
  presetId String
  userId String
  @@id([presetId,userId])
}
model BudgetLimit {
  id String @id @default(cuid())
  scope String
  targetId String
  monthlyMicros BigInt
  dailyMicros BigInt
  maxJobsPerDay Int
  @@unique([scope,targetId])
}

model StoredAsset {
  id String @id
  data Bytes
  size Int
  createdAt DateTime @default(now())
}

model CategoryMember {
  categoryId String
  userId String
  category Category @relation(fields:[categoryId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([categoryId,userId])
  @@index([userId])
}
model SubproductMember {
  subproductId String
  userId String
  subproduct Subproduct @relation(fields:[subproductId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([subproductId,userId])
  @@index([userId])
}

model OwnerRecovery {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model MailConfiguration {
  id String @id @default("global")
  host String
  port Int
  username String
  senderName String
  encryptedPassword String
  revision String
  verifiedRevision String?
  verifiedAt DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
}

model VisualAuditPolicy {
  id String @id @default("global")
  enabled Boolean @default(true)
  retentionDays Int @default(30)
  limitMb Int @default(32)
  revision Int @default(1)
  updatedAt DateTime @updatedAt
}

model AuditThumbnail {
  id String @id @default(cuid())
  versionId String @unique
  variationId String
  versionNumber Int
  actorId String
  actorName String
  projectId String
  projectName String
  productName String
  subproductName String
  model String
  data Bytes?
  size Int
  width Int
  height Int
  status String @default("AVAILABLE")
  createdAt DateTime @default(now())
  expiresAt DateTime
  removedAt DateTime?
  @@index([createdAt,id])
  @@index([expiresAt,status])
}

model AssetDeletion {
  path String @id
  createdAt DateTime @default(now())
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  @@index([nextAttemptAt])
}
model MaintenanceRun {
  id String @id @default(cuid())
  source String
  status String @default("RUNNING")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  result Json @default("{}")
  error String?
  @@index([startedAt])
}

model ProviderBillingCredential {
  provider String @id
  encryptedKey String
  maskedKey String
  updatedAt DateTime @updatedAt
}

model ProviderConnection {
  provider String @id
  encryptedKey String?
  maskedKey String?
  revision Int @default(1)
  verifiedRevision Int?
  verifiedAt DateTime?
  status String @default("NOT_CONFIGURED")
  error String?
  models Json @default("[]")
  updatedAt DateTime @updatedAt
}
