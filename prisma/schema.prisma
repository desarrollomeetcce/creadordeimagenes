generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  ADMIN
  USER
  OBSERVER
}
enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(USER)
  status AccountStatus @default(PENDING)
  createdAt DateTime @default(now())
  planId String?
  plan MembershipPlan? @relation(fields:[planId],references:[id])
  customPlans MembershipPlan[] @relation("CustomPlanRecipient")
  planValidUntil DateTime?
  sessions Session[]
  projects Project[]
  memberships ProjectMember[]
  categoryMemberships CategoryMember[]
  subproductMemberships SubproductMember[]
  passwordResets PasswordReset[]
  ownerRecovery OwnerRecovery?
  metaAccountGrants MetaAccountGrant[]
}
model PasswordReset {
  tokenHash String @id
  userId String
  user User @relation(fields:[userId],references:[id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}
model Session {
  id String @id
  userId String
  user User @relation(fields:[userId],references:[id])
  expiresAt DateTime
  @@index([expiresAt])
}
model Project {
  id String @id @default(cuid())
  seedKey String? @unique
  name String
  description String @default("")
  prompt String @default("")
  ownerId String
  owner User @relation(fields:[ownerId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  categories Category[]
  members ProjectMember[]
  brandKit BrandKit?
  allAdministrators Boolean @default(false)
  instructionPolicy Json @default("{}")
}
model ProjectMember {
  projectId String
  userId String
  permission String @default("VIEW")
  project Project @relation(fields:[projectId],references:[id])
  user User @relation(fields:[userId],references:[id])
  @@id([projectId,userId])
}
model Category {
  id String @id @default(cuid())
  name String
  prompt String @default("")
  projectId String
  project Project @relation(fields:[projectId],references:[id])
  settings Json @default("{}")
  applyPromptToAll Boolean @default(true)
  applySettingsToAll Boolean @default(true)
  subproducts Subproduct[]
  members CategoryMember[]
  @@index([projectId])
  instructionPolicy Json @default("{}")
  deletedAt DateTime?
  @@index([projectId,deletedAt])
}
model Subproduct {
  id String @id @default(cuid())
  name String
  prompt String @default("")
  categoryId String
  category Category @relation(fields:[categoryId],references:[id])
  settings Json @default("{}")
  deletedAt DateTime?
  members SubproductMember[]
  variations Variation[]
  @@index([categoryId])
  @@index([categoryId,deletedAt])
  instructionPolicy Json @default("{}")
}
model PromptVersion {
  id String @id @default(cuid())
  scope String
  resourceId String
  prompt String
  actorId String
  createdAt DateTime @default(now())
  @@index([resourceId,createdAt])
}
model Attachment {
  id String @id @default(cuid())
  scope String
  resourceId String
  name String
  mime String
  purpose String
  path String
  text String @default("")
  size Int
  createdAt DateTime @default(now())
  archivedAt DateTime?
  replacesId String?
  brandLogos BrandLogo[]
  @@index([scope,resourceId])
}

model BrandKit {
  projectId String @id
  project Project @relation(fields:[projectId],references:[id])
  name String @default("")
  prompt String @default("")
  colors Json @default("[]")
  font String?
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  logos BrandLogo[]
}
model BrandLogo {
  projectId String
  brand BrandKit @relation(fields:[projectId],references:[projectId],onDelete:Cascade)
  attachmentId String
  attachment Attachment @relation(fields:[attachmentId],references:[id],onDelete:Restrict)
  @@id([projectId,attachmentId])
}
model ProviderConfiguration {
  id String @id @default("global")
  provider String @default("openai")
  encryptedKey String?
  maskedKey String?
  revision Int @default(1)
  verifiedRevision Int?
  verifiedAt DateTime?
  status String @default("NOT_CONFIGURED")
  error String?
  models Json @default("[]")
  imageModel String?
  creativeModel String?
  creativeProvider String?
  alternatives Json @default("[]")
  quality String @default("low")
  resolution String @default("1024x1024")
  monthlyLimitMicros BigInt @default(0)
  dailyLimitMicros BigInt @default(0)
  operationLimitMicros BigInt @default(0)
  imageReserveMicros BigInt @default(0)
  maxGenerations Int @default(100)
  updatedAt DateTime @updatedAt
}
model GenerationJob {
  id String @id @default(cuid())
  actorId String
  projectId String
  subproductId String?
  idempotencyKey String @unique
  status String @default("PENDING")
  // Versioned SQL also indexes snapshot->>orderId when present (migration 024).
  snapshot Json
  reservedMicros BigInt
  archivedAt DateTime?
  error String?
  startedAt DateTime?
  leaseToken String?
  heartbeatAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  variation Variation?
  @@index([status,createdAt])
  @@index([status,heartbeatAt], map: "GenerationJob_heartbeat_idx")
  @@index([archivedAt,createdAt], map: "GenerationJob_archive_idx")
}
model BackgroundBatch {
  id String @id @default(cuid())
  actorId String
  requestKey String @unique
  jobIds Json
  status String @default("STARTING")
  runId String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([actorId,createdAt])
}
// Per-request progress is independent of historical execution batches.
model GenerationOrder {
  id String @id @default(cuid())
  actorId String
  requestKey String @unique
  jobIds Json
  status String @default("QUEUED")
  runId String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([actorId,createdAt])
  @@index([status,createdAt,id])
}
model Variation {
  id String @id @default(cuid())
  subproductId String?
  subproduct Subproduct? @relation(fields:[subproductId],references:[id])
  jobId String @unique
  job GenerationJob @relation(fields:[jobId],references:[id])
  path String
  model String
  permanent Boolean @default(false)
  favorite Boolean @default(false)
  reviewStatus String @default("PENDING")
  revision Int @default(1)
  deletedAt DateTime?
  versions ImageVersion[]
  libraryItems LibraryItem[]
  libraryCopies LibraryImageCopy[]
  libraryExclusions LibraryExclusion[]
  expiresAt DateTime
  expired Boolean @default(false)
  filesQueuedAt DateTime?
  createdAt DateTime @default(now())
  @@index([permanent,filesQueuedAt,expiresAt], map: "Variation_expiry_cleanup_idx")
}
model UsageLedger {
  id String @id @default(cuid())
  jobId String @unique
  actorId String
  projectId String
  model String
  reservedMicros BigInt
  actualMicros BigInt?
  usage Json?
  status String @default("RESERVED")
  createdAt DateTime @default(now())
  @@index([actorId,createdAt], map: "UsageLedger_actorId_createdAt_idx")
  @@index([createdAt,status])
}
model AuditEvent {
  id String @id @default(cuid())
  actorId String
  action String
  resourceId String?
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([actorId,createdAt])
}
model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
}

model ImageVersion {
  id String @id @default(cuid())
  variationId String
  variation Variation @relation(fields:[variationId],references:[id])
  number Int
  path String
  backgroundPath String?
  document Json?
  actorId String
  sourceJobId String? @unique
  createdAt DateTime @default(now())
  @@unique([variationId,number])
}

model LibraryFolder {
  anchorScope String?
  anchorId String?
  id String @id @default(cuid())
  userId String
  name String
  parentId String?
  parent LibraryFolder? @relation("FolderTree",fields:[parentId],references:[id])
  children LibraryFolder[] @relation("FolderTree")
  items LibraryItem[]
  documents LibraryDocument[]
  resourceBindings StorageBinding[]
  createdAt DateTime @default(now())
  @@index([userId,parentId])
}
model LibraryItem {
  destinationKey String?
  broughtAt DateTime?
  id String @id @default(cuid())
  userId String
  variationId String
  variation Variation @relation(fields:[variationId],references:[id])
  folderId String?
  folder LibraryFolder? @relation(fields:[folderId],references:[id])
  createdAt DateTime @default(now())
  @@unique([userId,variationId])
}
model SavedPreset {
  id String @id @default(cuid())
  userId String
  name String
  prompt String
  settings Json
  visibility String @default("PERSONAL")
  applyPromptToAll Boolean @default(true)
  applySettingsToAll Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  level String @default("legacy")
  policy Json @default("{}")
  @@index([level,updatedAt])
}
model PresetShare {
  presetId String
  userId String
  @@id([presetId,userId])
}
model BudgetLimit {
  id String @id @default(cuid())
  scope String
  targetId String
  monthlyMicros BigInt
  dailyMicros BigInt
  maxJobsPerDay Int
  @@unique([scope,targetId])
}

model StoredAsset {
  id String @id
  data Bytes
  size Int
  createdAt DateTime @default(now())
}

model CategoryMember {
  categoryId String
  userId String
  category Category @relation(fields:[categoryId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([categoryId,userId])
  @@index([userId])
}
model SubproductMember {
  subproductId String
  userId String
  subproduct Subproduct @relation(fields:[subproductId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([subproductId,userId])
  @@index([userId])
}

model OwnerRecovery {
  userId String @id
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  tokenHash String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model MailConfiguration {
  id String @id @default("global")
  host String
  port Int
  username String
  senderName String
  encryptedPassword String
  revision String
  verifiedRevision String?
  verifiedAt DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
}

model VisualAuditPolicy {
  id String @id @default("global")
  enabled Boolean @default(true)
  retentionDays Int @default(30)
  limitMb Int @default(32)
  revision Int @default(1)
  updatedAt DateTime @updatedAt
}

model AuditThumbnail {
  id String @id @default(cuid())
  versionId String @unique
  variationId String
  versionNumber Int
  actorId String
  actorName String
  projectId String
  projectName String
  productName String
  subproductName String
  model String
  data Bytes?
  size Int
  width Int
  height Int
  status String @default("AVAILABLE")
  createdAt DateTime @default(now())
  expiresAt DateTime
  removedAt DateTime?
  @@index([createdAt,id])
  @@index([expiresAt,status])
}

model AssetDeletion {
  path String @id
  createdAt DateTime @default(now())
  nextAttemptAt DateTime @default(now())
  attempts Int @default(0)
  @@index([nextAttemptAt])
}
model MaintenanceRun {
  id String @id @default(cuid())
  source String
  status String @default("RUNNING")
  startedAt DateTime @default(now())
  finishedAt DateTime?
  result Json @default("{}")
  error String?
  @@index([startedAt])
}

model ProviderBillingCredential {
  provider String @id
  encryptedKey String
  maskedKey String
  updatedAt DateTime @updatedAt
}

model ProviderConnection {
  provider String @id
  encryptedKey String?
  maskedKey String?
  revision Int @default(1)
  verifiedRevision Int?
  verifiedAt DateTime?
  status String @default("NOT_CONFIGURED")
  error String?
  models Json @default("[]")
  updatedAt DateTime @updatedAt
}

model MembershipPlan {
  id String @id
  name String
  description String @default("")
  priceCents Int
  monthlyImages Int?
  monthlyAIMicros BigInt?
  isPublic Boolean @default(true)
  customUserId String?
  customUser User? @relation("CustomPlanRecipient",fields:[customUserId],references:[id])
  archivedAt DateTime?
  updatedAt DateTime @updatedAt
  users User[]
  @@index([customUserId,archivedAt], map: "MembershipPlan_customUserId_archivedAt_idx")
}
model PaymentConnection {
 provider String @id
 encryptedCredentials String
 maskedCredentials Json
 merchantId String
 mode String @default("SANDBOX")
 currency String @default("USD")
 exchangeRateMicros BigInt @default(1000000)
 enabled Boolean @default(false)
 revision Int @default(1)
 verifiedRevision Int?
 verifiedAt DateTime?
 error String?
 updatedAt DateTime @updatedAt
}
model PlanPurchase {
 id String @id @default(cuid())
 userId String
 planId String
 planName String
 provider String
 connectionRevision Int
 mode String
 amountCents Int
 currency String
 status String @default("CREATING")
 externalId String? @unique
 externalPaymentId String? @unique
 requestId String @unique
 checkoutUrl String?
 error String?
 createdAt DateTime @default(now())
 paidAt DateTime?
 @@index([userId,createdAt])
}

model SiteContent {
 id String @id @default("public")
 content Json
 revision Int @default(1)
 updatedAt DateTime @updatedAt
}

model LibraryDocument {
  generationReady Boolean @default(true)
  previewPath String?
  text String @default("")
  purpose String @default("Referencia visual")
  description String @default("")
  destinationKey String?
  deletedAt DateTime?
  id String @id @default(cuid())
  userId String
  folderId String?
  folder LibraryFolder? @relation(fields:[folderId],references:[id],onDelete:SetNull)
  name String
  mime String
  path String
  size Int
  createdAt DateTime @default(now())
  @@index([userId,folderId], map:"LibraryDocument_user_folder_idx")
}
model LibraryExclusion {
 destinationKey String?
 broughtAt DateTime?
 userId String
 variationId String
 variation Variation @relation(fields:[variationId],references:[id],onDelete:Cascade)
 @@id([userId,variationId])
}

// Per-user organization never changes source hierarchy or permissions.
model LibraryNodeState {
  userId String
  nodeKey String
  parentKey String?
  hidden Boolean @default(false)
  @@id([userId,nodeKey])
}
// Copies share image bytes/history and retain current source authorization.
model LibraryImageCopy {
  id String @id @default(cuid())
  userId String
  variationId String
  variation Variation @relation(fields:[variationId],references:[id],onDelete:Cascade)
  destinationKey String
  createdAt DateTime @default(now())
  deletedAt DateTime?
  @@index([userId,destinationKey,createdAt])
  @@index([variationId])
}

// Historical engine metadata, retained for snapshots; new generation is AI only.
model GenerationEngineConfiguration {
 id String @id @default("global")
 aiEnabled Boolean @default(true)
 propioxEnabled Boolean @default(false)
 defaultEngine String @default("ai")
 quality String @default("high")
 resolution String @default("1024x1024")
 revision Int @default(1)
 updatedAt DateTime @updatedAt
}
// The resource owner/editor explicitly delegates this folder as generation material.
model StorageBinding {
 id String @id @default(cuid())
 scope String
 resourceId String
 userId String
 folderId String
 folder LibraryFolder @relation(fields:[folderId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@unique([scope,resourceId,folderId])
 @@index([scope,resourceId])
}

// Explicit visual delegation; source authorization is checked again before use.
model LibraryResourceBinding {
 id String @id @default(cuid())
 scope String
 resourceId String
 userId String
 selection String
 purpose String @default("Referencia visual")
 createdAt DateTime @default(now())
 @@unique([scope,resourceId,userId,selection])
 @@index([scope,resourceId])
}

model LargeAsset {
 id String @id
 userId String
 clientKey String
 name String
 mime String
 purpose String
 folderId String?
 size Int
 receivedBytes Int @default(0)
 status String @default("UPLOADING")
 previewPath String?
 documentId String?
 createdAt DateTime @default(now())
 expiresAt DateTime
 chunks LargeAssetChunk[]
 @@unique([userId,clientKey])
 @@index([status,expiresAt])
}
model LargeAssetChunk {
 assetId String
 asset LargeAsset @relation(fields:[assetId],references:[id],onDelete:Cascade)
 index Int
 size Int
 checksum String
 data Bytes
 @@id([assetId,index])
}

model MetaApiQuota {
  scope String @id
  nextReadAt DateTime @default(now()) @db.Timestamptz
  blockedUntil DateTime? @db.Timestamptz
  lastLimitedAt DateTime? @db.Timestamptz
  failures Int @default(0)
}
model MetaConnection {
  id String @id @default(cuid())
  ownerId String
  name String
  transport String
  apiVersion String @default("v23.0")
  appId String?
  encryptedAppSecret String?
  appSecretConfiguredAt DateTime?
  loginConfigId String?
  authMethod String?
  tokenExpiresAt DateTime?
  metaUserId String?
  encryptedToken String?
  tokenMask String?
  revision Int @default(1)
  tools Json @default("[]")
  verifiedAt DateTime?
  disconnectedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  accounts MetaAdAccount[]
  sources MetaAccountSource[]
}
model MetaAdAccount {
  id String @id
  connectionId String
  connection MetaConnection @relation(fields:[connectionId], references:[id])
  name String
  businessId String?
  businessName String?
  currency String
  timezone String
  accountStatus Int?
  enabled Boolean @default(false)
  metric String @default("AUTO")
  targetCost Decimal? @db.Decimal(18,6)
  minResults Int @default(10)
  intervalMinutes Int @default(30)
  selectionSince DateTime?
  totals MetaAdTotal[]
  historyFrom String?
  syncedAt DateTime?
  nextSyncAt DateTime?
  syncState Json @default("{}")
  syncToken String?
  syncLeaseAt DateTime?
  syncError String?
  schedulerToken String?
  schedulerRunId String?
  sources MetaAccountSource[]
  grants MetaAccountGrant[]
  objects MetaAdObject[]
  daily MetaAdDaily[]
  @@index([enabled,nextSyncAt])
}
model MetaAccountGrant {
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  id String @id @default(cuid())
  accountId String
  account MetaAdAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  userId String
  canSync Boolean @default(false)
  @@unique([accountId,userId])
  @@index([userId])
}
model MetaAliasTable {
  manualBaseDays MetaManualBaseDay[]
  advisorBaseDays MetaAdvisorBaseDay[]
  columnLinkTarget MetaEffectivenessLink? @relation("ColumnLinkDestination")
  columnLinkSources MetaEffectivenessLink[] @relation("ColumnLinkSource")
  colors MetaEffectivenessColors?
  syncTarget MetaEffectivenessSync? @relation("SyncDestination")
  syncSources MetaEffectivenessSync[] @relation("SyncSource")
  totals MetaEffectivenessTotalDay[]
  aliasColumnName String @default("Alias")
  defaultCountry String @default("")
  defaultCurrency String @default("")
  id String @id @default(cuid())
  name String @unique
  aliases MetaAlias[]
}
model MetaAlias {
 categoryAssignments MetaInventoryCategoryAssignment[]
 inventorySheetId String @default("default-inventory")
 inventorySheet MetaEffectivenessSheet @relation(fields:[inventorySheetId],references:[id],onDelete:Restrict)
 @@index([inventorySheetId])
 advisorAssignments MetaAdvisorAssignment[]
  id String @id @default(cuid())
  name String
  @@unique([tableId,name])
  objects MetaAdObject[]
  effectivenessRows MetaEffectivenessRow[]
  effectivenessStates MetaEffectivenessState[]
  tableId String @default("diplomados")
  table MetaAliasTable @relation(fields:[tableId],references:[id],onDelete:Restrict)
  @@index([tableId])
}
model MetaAdObject {
  advisorId String?
  advisor MetaAdvisor? @relation(fields:[advisorId],references:[id],onDelete:Restrict)
  @@index([aliasId,aliasCountry,advisorId])
  id String @id
  accountId String
  account MetaAdAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  level String
  campaignId String?
  adsetId String?
  name String
  objective String?
  optimizationGoal String?
  status String?
  effectiveStatus String?
  createdTime DateTime?
  scheduledStart DateTime?
  thumbnailUrl String?
  selectedAt DateTime?
  total MetaAdTotal?
  seenAt DateTime @default(now())
  daily MetaAdDaily[]
  aliasId String?
  aliasCountry String?
  alias MetaAlias? @relation(fields:[aliasId],references:[id],onDelete:SetNull)
  @@index([aliasId])
  @@index([aliasId,aliasCountry])
  insightCache MetaInsightCache?
  @@index([accountId,selectedAt,level])
  @@index([accountId,level,campaignId,adsetId])
}
model MetaAdDaily {
  id String @id @default(cuid())
  accountId String
  account MetaAdAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  objectId String
  object MetaAdObject @relation(fields:[objectId],references:[id],onDelete:Cascade)
  day String
  scope String @default("account-default")
  spend Decimal @db.Decimal(18,6)
  impressions Float @default(0)
  clicks Float @default(0)
  actions Json @default("{}")
  updatedAt DateTime @updatedAt
  @@unique([objectId,day,scope])
  @@index([accountId,day])
}
model MetaAdTotal {
  objectId String @id
  object MetaAdObject @relation(fields:[objectId],references:[id],onDelete:Cascade)
  accountId String
  account MetaAdAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  since String
  until String
  scope String
  spend Decimal @db.Decimal(18,6)
  impressions Float @default(0)
  clicks Float @default(0)
  actions Json @default("{}")
  updatedAt DateTime @updatedAt
  @@index([accountId,until])
}
model MetaOAuthState {
  id String @id
  purpose String @default("MCP")
  connectionId String
  ownerId String
  sessionId String
  connectionRevision Int @default(0)
  verifier String
  browserHash String
  tokenEndpoint String
  clientId String
  redirectUri String
  expiresAt DateTime
  @@index([expiresAt])
}

model MetaAccountSource {
  accountId String
  connectionId String
  revision Int
  verifiedAt DateTime @default(now())
  account MetaAdAccount @relation(fields:[accountId],references:[id],onDelete:Cascade)
  connection MetaConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  @@id([accountId,connectionId])
}

model MetaInsightCache {
  objectId String @id
  object MetaAdObject @relation(fields:[objectId],references:[id],onDelete:Cascade)
  day String
  version String
  rows Json
  updatedAt DateTime @updatedAt
}

model PrivacyRequest {
  id String @id @default(cuid())
  receiptHash String @unique
  kind String
  name String @default("")
  email String
  message String
  origin String
  status String @default("PENDING")
  reply String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}

// Rules use explicit account currencies; analyses contain no credentials.
model MetaRecommendationRules {
  currency String @id
  values Json
  updatedAt DateTime @updatedAt
}
model MetaRecommendationAnalysis {
  key String @id
  campaignId String
  @@index([campaignId])
  fingerprint String
  parameters Json
  payload Json
  computedAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}

model MetaRecommendationSource {
  campaignId String @id
  accountId String
  connectionId String
  revision Int
  state Json
  updatedAt DateTime @updatedAt
  @@index([accountId])
}

model MetaEffectivenessRow {
 salesApprovals MetaAdvisorSalesApproval[]
 advisorId String?
 advisor MetaAdvisor? @relation(fields:[advisorId],references:[id],onDelete:Restrict)
 @@index([advisorId])
 legacy Boolean @default(false)
 displayCurrency String @default("")
 presentationRowId String?
 presentation MetaEffectivenessRow? @relation("FxLegacyRows",fields:[presentationRowId],references:[id],onDelete:SetNull)
 legacySources MetaEffectivenessRow[] @relation("FxLegacyRows")
 @@index([presentationRowId])
 id String @id @default(cuid())
 hidden Boolean @default(false)
 revision Int @default(0)
 aliasId String
 alias MetaAlias @relation(fields:[aliasId],references:[id],onDelete:Restrict)
 country String
 currency String
 days MetaEffectivenessDay[]
 @@unique([aliasId,country,currency])
}
model MetaEffectivenessDay {
 annotations Json @default("{}")
 salesOverridden Boolean @default(false)
 fixedCostOverridden Boolean @default(false)
 fixedCostCurrency String?
 rowId String
 row MetaEffectivenessRow @relation(fields:[rowId],references:[id],onDelete:Cascade)
 day String
 sales Int?
 fixedCost Decimal? @db.Decimal(18,6)
 revision Int @default(1)
 @@id([rowId,day])
}

model MetaFxDay {
 day String @id
 rates Json @default("{}")
 source String
 sourceUrl String
 fetchedAt DateTime @default(now())
 lastError String?
}

model MetaEffectivenessState {
 id String @id @default(cuid())
 aliasId String
 alias MetaAlias @relation(fields:[aliasId],references:[id],onDelete:Cascade)
 country String
