{
  "name": "creadordeimagenes",
  "version": "1.0.0",
  "description": "Sistema de generación automática de afiches publicitarios mediante inteligencia artificial.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/core.test.ts tests/design.test.ts",
    "worker": "tsx scripts/worker.ts",
    "db:generate": "node scripts/generate.mjs",
    "db:deploy": "node scripts/migrate.mjs",
    "postinstall": "node scripts/generate.mjs",
    "test:integration": "tsx --test tests/integration.test.ts"
  },
  "repository": {
    "type": "git",
