  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@xmldom/xmldom": "^0.8.15",
    "argon2": "^0.45.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
