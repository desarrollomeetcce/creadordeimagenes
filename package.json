    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
