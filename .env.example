DATABASE_URL=postgresql://afiches:CHANGE_ME@localhost:5432/afiches
APP_ORIGIN=http://localhost:3000
# Generar una vez: openssl rand -base64 32. Conservar en gestor de secretos; no subir a Git.
AI_MASTER_KEY=
# Token de instalación de un solo uso (mínimo 32 caracteres); retirar después de crear el owner.
BOOTSTRAP_TOKEN=
STORAGE_PATH=./data/assets
# Opcional: conexión directa sin pool para aplicar migraciones en un proveedor administrado.
DIRECT_DATABASE_URL=

# Archivos: en Vercel se usa postgres automáticamente; en VPS, disco local por defecto.
# STORAGE_BACKEND=postgres
# Capacidad de archivos en PostgreSQL para pruebas (MB binarios; no limita la factura total de la base).
STORAGE_LIMIT_MB=128

# Opcional: autorización de la limpieza diaria de Vercel (mínimo 32 caracteres aleatorios).
# Se configura una sola vez en Production; nunca usar aquí un valor real ni compartirlo en Git.
CRON_SECRET=
